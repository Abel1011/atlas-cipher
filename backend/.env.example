# Required API keys
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional ElevenLabs override for Vivienne / handler narration voice
ELEVENLABS_HANDLER_VOICE_ID=MOzcTXRqxY5JuCSQXZk9

# Feature flags
ENABLE_AI_CASE_GENERATION=true
ENABLE_SEED_IMAGE_GENERATION=false

# Azure OpenAI deployment selection
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
AZURE_OPENAI_TEXT_MODEL=gpt-5.4
AZURE_OPENAI_CASE_MODEL=gpt-5.4
AZURE_OPENAI_CASE_REASONING_EFFORT=high
AZURE_OPENAI_DIALOGUE_MODEL=gpt-5.4-mini
AZURE_OPENAI_DIALOGUE_REASONING_EFFORT=low
AZURE_OPENAI_HANDLER_MEMORY_MODEL=gpt-5.4-nano
AZURE_OPENAI_HANDLER_MEMORY_REASONING_EFFORT=low
AZURE_OPENAI_WITNESS_MEMORY_MODEL=gpt-5.4-nano
AZURE_OPENAI_WITNESS_MEMORY_REASONING_EFFORT=low
AZURE_OPENAI_IMAGE_MODEL=gpt-image-2
AZURE_OPENAI_MAX_RETRIES=3

# ElevenLabs transport defaults
ELEVENLABS_MAX_RETRIES=3
ELEVENLABS_TIMEOUT_SECONDS=60